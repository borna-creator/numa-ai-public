# Shared secret — must match WORKER_SECRET on VPS 1 (NumaIQ API)
WORKER_SECRET=change-me-to-a-long-random-string

# Port this worker listens on (VPS 1 sets WORKER_URL=http://<vps2-ip>:4000)
WORKER_PORT=4000
# Max jobs processed in parallel (default 3)
WORKER_CONCURRENCY=3

# Phase 3 — live pipeline (both required unless WORKER_MODE=mock)
DEEPGRAM_API_KEY=
DEEPINFRA_API_KEY=

# Voice assistant (LiveKit — credentials stay on this server only)
# Use the WebSocket URL from LiveKit Cloud (must start with wss://)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Optional: must match the agent name registered by your LiveKit agent worker
# Without this, the browser connects but no assistant joins the room
LIVEKIT_AGENT_NAME=
# Legacy alias (same value as DEEPINFRA_API_KEY) — only needed on older worker builds
# DEEPSEEK_API_KEY=
# Optional DeepInfra model (default deepseek-ai/DeepSeek-V4-Flash)
# DEEPINFRA_MODEL=deepseek-ai/DeepSeek-V4-Flash
# DEEPINFRA_API_URL=https://api.deepinfra.com/v1/openai/chat/completions

# Force mock scoring (ignores API keys above)
# WORKER_MODE=mock
