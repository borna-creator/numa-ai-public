# Shared secret — must match WORKER_SECRET on VPS 1 (NumaIQ API)
WORKER_SECRET=change-me-to-a-long-random-string

WORKER_PORT=4000
WORKER_CONCURRENCY=3

DEEPGRAM_API_KEY=
DEEPINFRA_API_KEY=

# --- Self-hosted LiveKit on VPS 2 (see docs/VOICE-AGENTS-VPS2.md) ---
# Internal URL for token mint + agent dispatch
LIVEKIT_URL=ws://127.0.0.1:7880
# Browser WebSocket URL (wss when proxied through numa-iq.com)
# LIVEKIT_PUBLIC_URL=wss://numa-iq.com/livekit
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# One agent worker per language — names must match your running agents
LIVEKIT_AGENT_ENGLISH=numa-agent-en
LIVEKIT_AGENT_FRENCH=numa-agent-fr
LIVEKIT_AGENT_ARABIC=numa-agent-ar

# Legacy single-agent alias (English fallback)
# LIVEKIT_AGENT_NAME=numa-agent-en
