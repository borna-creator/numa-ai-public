# Marketing site (build-time)
VITE_SITE_URL=https://numa-iq.com

# Platform frontend (dev — use same origin; Vite proxies /auth and /api)
VITE_WEBSITE_DOMAIN=http://localhost:5173
# Leave empty to use relative URLs through Vite proxy
VITE_API_DOMAIN=

# API server
API_PORT=3001
API_DOMAIN=http://localhost:5173
WEBSITE_DOMAIN=http://localhost:5173

# Database (app data — Prisma)
DATABASE_URL=postgresql://numaiq:numaiq@localhost:5432/numaiq

# SuperTokens core
SUPERTOKENS_CONNECTION_URI=http://localhost:3567

# Seeded on first server start (change in production!)
SUPER_ADMIN_EMAIL=admin@numa-iq.com
SUPER_ADMIN_PASSWORD=ChangeMe123!

# Call audio storage (VPS 1 — absolute or relative path)
CALL_STORAGE_PATH=./storage/calls
# Max upload size in bytes (default 100MB)
CALL_MAX_UPLOAD_BYTES=104857600
# Max files per batch upload (default 20)
CALL_MAX_BATCH_FILES=20

# Phase 2 — AI worker on VPS 2 (see vps2-worker/README.md)
# Same WORKER_SECRET in repo root .env and vps2-worker/.env
# Generate: openssl rand -hex 32
WORKER_SECRET=66e6253c2a20ef3510b01a3b70ef6c13587c87ab4ad2eac2be09e1e8b5378a00

# Worker base URL (local: http://127.0.0.1:4000, prod: http://<vps2-ip>:4000)
WORKER_URL=http://185.197.31.158:4000
# Signed audio URL lifetime for worker downloads (seconds)
JOB_AUDIO_TOKEN_TTL_SEC=3600

# Phase 3 — API keys live on VPS 2 worker only (DEEPGRAM_API_KEY, DEEPINFRA_API_KEY)
# Voice assistant credentials also live on VPS 2 (LIVEKIT_*). See vps2-worker/.env.example
