# Marketing site (build-time)
VITE_SITE_URL=https://numa-iq.com

# Platform frontend (dev — use same origin; Vite proxies /auth and /api)
VITE_WEBSITE_DOMAIN=http://localhost:5173
# Leave empty to use relative URLs through Vite proxy
VITE_API_DOMAIN=

# API server
API_PORT=3001
API_DOMAIN=http://localhost:5173
WEBSITE_DOMAIN=http://localhost:5173

# Database (app data — Prisma)
DATABASE_URL=postgresql://numaiq:numaiq@localhost:5432/numaiq

# SuperTokens core
SUPERTOKENS_CONNECTION_URI=http://localhost:3567

# Seeded on first server start (change in production!)
SUPER_ADMIN_EMAIL=admin@numa-iq.com
SUPER_ADMIN_PASSWORD=ChangeMe123!

# Call audio storage (VPS 1 — absolute or relative path)
CALL_STORAGE_PATH=./storage/calls
# Max upload size in bytes (default 100MB)
CALL_MAX_UPLOAD_BYTES=104857600
