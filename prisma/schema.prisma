generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ORG_ADMIN
  USER
}

enum CallStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum CriterionQuestionType {
  YES_NO
  EXCELLENT_GOOD_POOR
  CONVERSATIONAL
}

enum ScorecardLanguage {
  ENGLISH
  ARABIC
  FRENCH
}

enum ProcessingJobStatus {
  PENDING
  DISPATCHED
  COMPLETED
  FAILED
}

model Organization {
  id              String       @id @default(cuid())
  name            String
  slug            String       @unique
  usageMinutesCap        Int?
  usageMinutesMonthlyCap Int?
  usageResetDayOfMonth   Int?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  departments     Department[]
  users           User[]
  scorecards      Scorecard[]
  calls           Call[]
}

model Department {
  id             String       @id @default(cuid())
  name           String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users          User[]
  calls          Call[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
}

model User {
  id                String        @id @default(cuid())
  email             String        @unique
  superTokensUserId String        @unique
  fullName          String?
  jobTitle          String?
  role              Role
  organizationId    String?
  organization      Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId      String?
  department        Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  uploadedCalls     Call[]        @relation("UploadedCalls")
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([organizationId])
  @@index([departmentId])
}

model Scorecard {
  id             String               @id @default(cuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  language       ScorecardLanguage    @default(ENGLISH)
  sttSettings    Json?
  isActive       Boolean              @default(true)
  criteria       ScorecardCriterion[]
  calls          Call[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
}

model ScorecardCriterion {
  id           String                @id @default(cuid())
  scorecardId  String
  scorecard    Scorecard             @relation(fields: [scorecardId], references: [id], onDelete: Cascade)
  label        String
  description  String?
  questionType CriterionQuestionType @default(YES_NO)
  weight       Int                   @default(1)
  sortOrder    Int                   @default(0)
  results      CallCriterionResult[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([scorecardId])
}

model Call {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId   String?
  department     Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  uploadedById   String
  uploadedBy     User         @relation("UploadedCalls", fields: [uploadedById], references: [id], onDelete: Restrict)
  scorecardId    String?
  scorecard      Scorecard?   @relation(fields: [scorecardId], references: [id], onDelete: SetNull)
  originalName   String
  mimeType       String
  fileSize       Int
  storagePath    String
  durationSec    Int?
  tags           String[]              @default([])
  status         CallStatus            @default(PENDING)
  errorMessage   String?
  overallScore   Int?
  transcript     CallTranscript?
  results        CallCriterionResult[]
  processingJob  ProcessingJob?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([departmentId])
  @@index([uploadedById])
  @@index([scorecardId])
  @@index([status])
  @@index([createdAt])
}

model CallTranscript {
  id        String   @id @default(cuid())
  callId    String   @unique
  call      Call     @relation(fields: [callId], references: [id], onDelete: Cascade)
  fullText  String   @db.Text
  segments  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CallCriterionResult {
  id          String             @id @default(cuid())
  callId      String
  call        Call               @relation(fields: [callId], references: [id], onDelete: Cascade)
  criterionId String
  criterion   ScorecardCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  value       String
  passed      Boolean?
  reasoning   String?            @db.Text
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([callId, criterionId])
  @@index([callId])
}

model ProcessingJob {
  id             String              @id @default(cuid())
  callId         String              @unique
  call           Call                @relation(fields: [callId], references: [id], onDelete: Cascade)
  organizationId String
  status         ProcessingJobStatus @default(PENDING)
  attempts       Int                 @default(0)
  lastError      String?
  dispatchedAt   DateTime?
  completedAt    DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([organizationId])
  @@index([status])
}
