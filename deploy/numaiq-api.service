[Unit]
Description=NumaIQ QA Platform API
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=generaladmin
WorkingDirectory=/var/www/numaiq
EnvironmentFile=/var/www/numaiq/.env
ExecStart=/usr/bin/node server/index.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
