# Nginx — NumaIQ marketing site + QA platform API
# /etc/nginx/sites-available/numaiq
#
# After copying this file, run certbot to enable HTTPS:
#   sudo certbot --nginx -d numa-iq.com -d www.numa-iq.com
#
# If certbot already ran but /auth returns errors on HTTPS, open the SSL
# server block and ensure the /auth and /api locations below are present there too.

server {
    listen 80;
    listen [::]:80;
    server_name numa-iq.com www.numa-iq.com;

    root /var/www/numaiq/dist;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml;
    gzip_min_length 256;

    # Call audio uploads (default nginx limit is 1MB)
    client_max_body_size 100M;

    # SuperTokens auth + API (Node on port 3001)
    location /auth {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # SPA fallback — /platform, /privacy, /terms, etc.
    location / {
        try_files $uri $uri/ /index.html;
    }

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
}

