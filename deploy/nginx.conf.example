# Nginx config for NumaIQ static site (Vite + React Router)
# Copy to: /etc/nginx/sites-available/numaiq
# Then: sudo ln -s /etc/nginx/sites-available/numaiq /etc/nginx/sites-enabled/
# Replace YOUR_DOMAIN.com with your actual domain.

server {
    listen 80;
    listen [::]:80;
    server_name YOUR_DOMAIN.com www.YOUR_DOMAIN.com;

    root /var/www/numaiq/dist;
    index index.html;

    # Gzip
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml;
    gzip_min_length 256;

    # Cache static assets
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # SPA fallback — required for /privacy, /terms, etc.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
}

# After certbot runs, it will add a second server {} block for HTTPS automatically.
